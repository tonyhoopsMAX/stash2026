{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "STASH",
  "version": "1.0.0",
  "identifier": "com.stash.app",
  "build": {
    "frontendDist": "../dist/native-web",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:native-web"
  },
  "app": {
    "windows": [
      {
        "title": "STASH",
        "width": 1000,
        "height": 720,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
